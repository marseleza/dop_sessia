<Window x:Class="FunctionPlotter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Построитель графиков (PostgreSQL)" Height="700" Width="1100">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <TextBlock Text="Функция:" FontWeight="Bold"/>
                <UniformGrid Columns="3" Margin="0,5,0,10">
                    <Button Content="sin" Command="{Binding SelectFunctionCommand}" CommandParameter="sin" Margin="2"/>
                    <Button Content="cos" Command="{Binding SelectFunctionCommand}" CommandParameter="cos" Margin="2"/>
                    <Button Content="exp" Command="{Binding SelectFunctionCommand}" CommandParameter="exp" Margin="2"/>
                </UniformGrid>

                <TextBlock Text="{Binding FunctionInfo}" FontStyle="Italic"
                           Foreground="DarkBlue" Margin="0,0,0,10"/>

                <TextBlock Text="Коэффициенты:" FontWeight="Bold"/>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="A:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding A, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="B:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding B, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="C:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding C, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="Диапазон X:" FontWeight="Bold" Margin="0,10,0,0"/>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="от:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding XMin, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="до:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding XMax, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Button Content="Построить график" Command="{Binding PlotCommand}"
                        Height="35" FontWeight="Bold" Background="LightGreen"/>

                <TextBlock Text="История (последние 50):" FontWeight="Bold" Margin="0,15,0,5"/>
                <ListBox ItemsSource="{Binding History}" Height="200"/>
            </StackPanel>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Background="White">
                <Grid>
                    <TextBlock Text="{Binding PlotTitle}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,5,0,0"/>
                    <Canvas x:Name="PlotCanvas" ClipToBounds="True"
                            Margin="40,30,20,30"
                            SizeChanged="PlotCanvas_SizeChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Строка статуса -->
        <StatusBar Grid.Row="1" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>